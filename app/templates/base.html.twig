<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Jardins de Cocagne{% endblock %} · Gestion commerciale</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🥕</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header">
            <a class="site-logo" href="{{ path('app_accueil') }}">Jardins de Cocagne</a>
            <nav class="site-nav" aria-label="Navigation principale">
                <a href="{{ path('app_accueil') }}" {% if app.current_route == 'app_accueil' %}aria-current="page"{% endif %}>Accueil</a>
                <a href="{{ path('app_commande') }}" {% if app.current_route == 'app_commande' %}aria-current="page"{% endif %}>Commander</a>
                <a href="{{ path('app_carte') }}" {% if app.current_route == 'app_carte' %}aria-current="page"{% endif %}>Points de dépôt</a>
            </nav>
        </header>

        <main class="site-main">
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            Projet SAÉ 5 — Lucas Charpentier · Ahmed Errebache — BUT3 Informatique, IUT de Saint-Dié-des-Vosges
        </footer>
    </body>
</html>
